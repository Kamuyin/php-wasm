+
+PHPAPI char *php_socket_strerror(long err, char *buf, size_t bufsize)
+{
+	char *errstr = strerror((int)err);
+	if (buf == NULL) {
+		buf = estrdup(errstr ? errstr : "Unknown error");
+	} else {
+		strncpy(buf, errstr ? errstr : "Unknown error", bufsize);
+		buf[bufsize ? (bufsize - 1) : 0] = 0;
+	}
+	return buf;
+}
+
+PHPAPI zend_string *php_socket_error_str(long err)
+{
+	char *errstr = strerror((int)err);
+	return zend_string_init(errstr ? errstr : "Unknown error",
+		errstr ? strlen(errstr) : 13, 0);
+}
