 static int php_do_open_temporary_file(const char *path, const char *pfx, zend_string **opened_path_p)
 {
+  /* wasi-libc does not provide mkstemp. Create an unpredictable name and
+   * claim it exclusively inside an admitted preopen. Never follow an existing
+   * file/symlink or truncate a file when a name collides. */
+  unsigned char random[16];
+  char suffix[33], filename[MAXPATHLEN];
+  static const char hex[] = "0123456789abcdef";
+  if (!path || !*path) {
+    errno = ENOENT;
+    return -1;
+  }
+  for (int attempt = 0; attempt < 100; attempt++) {
+    if (__wasi_random_get(random, sizeof(random)) != __WASI_ERRNO_SUCCESS) {
+      errno = EIO;
+      return -1;
+    }
+    for (size_t i = 0; i < sizeof(random); i++) {
+      suffix[2*i] = hex[random[i] >> 4];
+      suffix[2*i+1] = hex[random[i] & 15];
+    }
+    suffix[32] = '\0';
+    if (snprintf(filename, sizeof(filename), "%s/%s%s", path, pfx, suffix) >= sizeof(filename)) {
+      errno = ENAMETOOLONG;
+      return -1;
+    }
+    int fd = VCWD_OPEN_MODE(filename, O_CREAT | O_EXCL | O_RDWR, 0600);
+    if (fd >= 0) {
+      if (opened_path_p) {
+        *opened_path_p = zend_string_init(filename, strlen(filename), 0);
+      }
+      return fd;
+    }
+    if (errno != EEXIST) {
+      return -1;
+    }
+  }
+  errno = EEXIST;
   return -1;
 }
 #endif // __wasi__
