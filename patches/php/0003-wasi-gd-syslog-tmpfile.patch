diff --git a/ext/standard/syslog.c b/ext/standard/syslog.c
--- a/ext/standard/syslog.c
+++ b/ext/standard/syslog.c
@@ -228,3 +228,23 @@ PHPAPI void php_syslog_str(int priority, const char *message, size_t message_le
 }
 /* }}} */
 #endif /* HAVE_SYSLOG_H */
+
+#if !HAVE_SYSLOG_H && defined(__wasi__)
+/* On WASI, AC_CHECK_FUNC(syslog) fails because wasi-libc exposes no
+ * linkable syslog symbol, leaving HAVE_SYSLOG_H=0 and the block above
+ * uncompiled. mail() and PHP's error logger still call these internal
+ * wrappers; provide no-op stubs so the linker is satisfied. */
+PHPAPI void php_openlog(const char *ident, int option, int facility)
+{
+	(void)ident; (void)option; (void)facility;
+}
+PHPAPI void php_closelog(void) {}
+PHPAPI void php_syslog(int priority, const char *message)
+{
+	(void)priority; (void)message;
+}
+PHPAPI void php_syslog_str(int priority, const char *message, size_t message_len)
+{
+	(void)priority; (void)message; (void)message_len;
+}
+#endif /* !HAVE_SYSLOG_H && __wasi__ */
