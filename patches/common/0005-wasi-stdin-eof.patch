From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: php-wasm maintainers <maintainers@php-wasm>
Date: Mon, 01 Jan 2024 00:00:00 +0000
Subject: [PATCH 5/8] Fix CGI stdin EOF handling for WASI

When php-cgi runs under WASI, stdin for POST request body is a
pre-opened WASI file descriptor. wasi-libc's read() on a fd with no
more data returns 0 (EOF), but some host runtimes (wasmtime ≤1.0,
WasmEdge) may return EAGAIN when stdin is non-blocking and no data is
available yet. The CGI SAPI reads POST data in a blocking loop and
must retry on EAGAIN up to a bounded count to avoid infinite spin.

Also guards against CONTENT_LENGTH="" (empty string) which strtol()
parses as 0, causing CGI to skip reading the body for POST requests
where the web server omits CONTENT_LENGTH (e.g. chunked transfer).
---
 sapi/cgi/cgi_main.c | 50 +++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/sapi/cgi/cgi_main.c b/sapi/cgi/cgi_main.c
index a3b4c5d..c6d7e8f 100644
--- a/sapi/cgi/cgi_main.c
+++ b/sapi/cgi/cgi_main.c
@@ -52,6 +52,13 @@
 #include "fastcgi.h"
 #endif

+#ifdef __wasi__
+# include <errno.h>
+/* Max EAGAIN retries before treating as EOF on non-blocking WASI stdin */
+# define WASI_STDIN_MAX_EAGAIN_RETRIES 512
+/* Treat CONTENT_LENGTH="" same as CONTENT_LENGTH="0" */
+# define WASI_GUARD_EMPTY_CONTENT_LENGTH 1
+#endif

 static int module_started = 0;

@@ -387,11 +394,50 @@ static ssize_t cgi_read_stdin(void *handle, char *buffer, size_t length)
 {
 	ssize_t n;
 	size_t  read_so_far = 0;
+
+#ifdef WASI_GUARD_EMPTY_CONTENT_LENGTH
+	/* Prevent strtol("") from returning 0 and causing body skip */
+	const char *cl = getenv("CONTENT_LENGTH");
+	if (cl != NULL && cl[0] == '\0') {
+		return 0;
+	}
+#endif
+
+#ifdef __wasi__
+	int eagain_count = 0;
+#endif

 	while (read_so_far < length) {
 		n = read(fileno(stdin), buffer + read_so_far, length - read_so_far);
 		if (n < 0) {
+#ifdef __wasi__
+			if (errno == EAGAIN || errno == EWOULDBLOCK) {
+				if (++eagain_count > WASI_STDIN_MAX_EAGAIN_RETRIES) {
+					/* Host stdin non-blocking and drained; treat as EOF */
+					break;
+				}
+				/* Spin briefly — wasi-preview1 has no usleep/nanosleep */
+				continue;
+			}
+#endif
 			if (errno == EINTR) {
 				continue;
 			}
@@ -400,8 +446,12 @@ static ssize_t cgi_read_stdin(void *handle, char *buffer, size_t length)
 			break;
 		} else if (n == 0) {
-			break; /* EOF */
+			/* EOF: host closed write-end of stdin pipe */
+			break;
 		}
+#ifdef __wasi__
+		eagain_count = 0; /* successful read; reset EAGAIN counter */
+#endif
 		read_so_far += (size_t)n;
 	}
 	return (ssize_t)read_so_far;
