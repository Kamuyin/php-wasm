From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: php-wasm maintainers <maintainers@php-wasm>
Date: Mon, 01 Jan 2024 00:00:00 +0000
Subject: [PATCH 1/8] Fix mmap alignment for WASI target

WASI's mmap (backed by memory.grow) requires sizes to be aligned to the
WASM page size (65536 bytes). The Zend memory allocator calls mmap with
sizes that are multiples of ZEND_MM_CHUNK_SIZE (2MB by default), which
satisfies this, but the munmap path may pass sub-page sizes on partial
free. Ensure all mmap/munmap calls round up to the nearest WASM page
boundary.

MAP_ANONYMOUS may not be defined on all wasi-libc versions; use MAP_ANON
as the canonical spelling with a compatibility alias where needed.
---
 Zend/zend_alloc.c | 44 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/Zend/zend_alloc.c b/Zend/zend_alloc.c
index a1b2c3d..e4f5a6b 100644
--- a/Zend/zend_alloc.c
+++ b/Zend/zend_alloc.c
@@ -218,6 +218,28 @@ static void *zend_mm_mmap_fixed(void *addr, size_t size)
 # define MAP_ANON MAP_ANONYMOUS
 #endif

+#ifdef __wasi__
+/* WASM page size is 65536 bytes; all mmap sizes must be multiples of this.
+ * The Zend allocator uses 2MB chunks which already satisfies this, but
+ * defensive rounding prevents future regressions. */
+# define WASM_PAGE_SIZE 65536UL
+# define WASI_ALIGN_MMAP_SIZE(sz) \
+	(((sz) + (WASM_PAGE_SIZE - 1)) & ~(WASM_PAGE_SIZE - 1))
+
+/* wasi-libc may not expose MAP_FIXED; define as no-op for compat */
+# ifndef MAP_FIXED
+#  define MAP_FIXED 0
+# endif
+#endif /* __wasi__ */
+
 static void *zend_mm_mmap(size_t size)
 {
 	void *ptr;
@@ -226,9 +248,25 @@ static void *zend_mm_mmap(size_t size)
 	ptr = VirtualAlloc(NULL, size, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
 	if (ptr == NULL) {
 		return NULL;
-	}
+	}
 #else
+# ifdef __wasi__
+	{
+		size_t aligned_size = WASI_ALIGN_MMAP_SIZE(size);
+		ptr = mmap(NULL, aligned_size, PROT_READ | PROT_WRITE,
+		           MAP_PRIVATE | MAP_ANON, -1, 0);
+		if (ptr == MAP_FAILED) {
+			return NULL;
+		}
+		if (aligned_size > size) {
+			memset((char *)ptr + size, 0, aligned_size - size);
+		}
+		return ptr;
+	}
+# else
 	ptr = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
 	if (ptr == MAP_FAILED) {
 #ifdef ZEND_MM_ERROR
@@ -238,6 +276,7 @@ static void *zend_mm_mmap(size_t size)
 		ptr = NULL;
 	}
 #endif
+# endif /* __wasi__ */
 	return ptr;
 }

@@ -248,7 +287,16 @@ static void zend_mm_munmap(void *addr, size_t size)
 	if (VirtualFree(addr, 0, MEM_RELEASE) == 0) {
 		ZEND_MM_CUSTOM_DEALLOCATOR(addr);
 	}
-#else
-	if (munmap(addr, size) != 0) {
+#elif defined(__wasi__)
+	{
+		size_t aligned_size = WASI_ALIGN_MMAP_SIZE(size);
+		if (munmap(addr, aligned_size) != 0) {
+			ZEND_MM_CUSTOM_DEALLOCATOR(addr);
+		}
+	}
+#else
+	if (munmap(addr, size) != 0) {
 		ZEND_MM_CUSTOM_DEALLOCATOR(addr);
 	}
 #endif
