From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: php-wasm maintainers <maintainers@php-wasm>
Date: Mon, 01 Jan 2024 00:00:00 +0000
Subject: [PATCH 3/8] Stub fork/exec/popen/pcntl with ENOSYS for WASI

WASI does not support process creation. PHP's ext/standard/exec.c and
ext/standard/proc_open.c use fork(), execve(), popen(), and pipe() in
ways that are undefined under wasm32-wasi. Without stubs, the linker
fails or the functions silently malfunction at runtime.

This patch replaces POSIX process functions with ENOSYS stubs that
return false and emit E_WARNING. PHP functions affected:
  exec(), shell_exec(), system(), passthru(), popen(), pclose(),
  proc_open(), proc_close(), proc_get_status(), proc_terminate(),
  proc_nice()
---
 ext/standard/exec.c      | 40 ++++++++++++++++++++++++++++++++++++++++
 ext/standard/proc_open.c | 28 ++++++++++++++++++++++++++++
 2 files changed, 68 insertions(+)

diff --git a/ext/standard/exec.c b/ext/standard/exec.c
index d1e2f3a..b4c5e6b 100644
--- a/ext/standard/exec.c
+++ b/ext/standard/exec.c
@@ -44,6 +44,44 @@
 #include <signal.h>
 #endif

+#ifdef __wasi__
+/* WASI has no process spawning; all exec/system functions are disabled.
+ * Return false and set errno = ENOSYS to match WASI syscall convention. */
+
+static void php_wasi_process_disabled(
+	INTERNAL_FUNCTION_PARAMETERS, const char *fname)
+{
+	php_error_docref(NULL, E_WARNING,
+		"%s() has been disabled: process spawning is not supported "
+		"under WASI (wasm32-wasi Preview1 — no fork/exec syscalls)",
+		fname);
+	errno = ENOSYS;
+	RETURN_FALSE;
+}
+
+PHP_FUNCTION(exec)
+{ php_wasi_process_disabled(INTERNAL_FUNCTION_PARAM_PASSTHRU, "exec"); }
+
+PHP_FUNCTION(system)
+{ php_wasi_process_disabled(INTERNAL_FUNCTION_PARAM_PASSTHRU, "system"); }
+
+PHP_FUNCTION(passthru)
+{ php_wasi_process_disabled(INTERNAL_FUNCTION_PARAM_PASSTHRU, "passthru"); }
+
+PHP_FUNCTION(shell_exec)
+{ php_wasi_process_disabled(INTERNAL_FUNCTION_PARAM_PASSTHRU, "shell_exec"); }
+
+PHP_FUNCTION(popen)
+{
+	php_error_docref(NULL, E_WARNING,
+		"popen() has been disabled: pipe creation requires a host process "
+		"(not available under WASI)");
+	errno = ENOSYS;
+	RETURN_FALSE;
+}
+
+PHP_FUNCTION(pclose) { RETURN_LONG(-1); }
+
+#else /* !__wasi__ — full POSIX implementation follows */
+
 /* {{{ proto string exec(string command [, array &output [, int &return_var]])
    Execute an external program */
 PHP_FUNCTION(exec)
@@ -201,6 +239,8 @@ PHP_FUNCTION(pclose)
 	RETURN_LONG(ret);
 }

+#endif /* __wasi__ */
+
 /* {{{ proto bool proc_terminate(resource process [, int signal]) */
diff --git a/ext/standard/proc_open.c b/ext/standard/proc_open.c
index e7f8a1b..c9d0e2c 100644
--- a/ext/standard/proc_open.c
+++ b/ext/standard/proc_open.c
@@ -39,6 +39,32 @@
 #include "ext/standard/php_smart_string.h"
 #include "proc_open_arginfo.h"

+#ifdef __wasi__
+/* proc_open and related functions require fork()+exec() or CreateProcess().
+ * Neither is available under WASI. Return false with E_WARNING. */
+
+PHP_FUNCTION(proc_open)
+{
+	php_error_docref(NULL, E_WARNING,
+		"proc_open() has been disabled: subprocess creation is not supported "
+		"under WASI (wasm32-wasi Preview1)");
+	errno = ENOSYS;
+	RETURN_FALSE;
+}
+
+PHP_FUNCTION(proc_close)    { RETURN_LONG(-1); }
+PHP_FUNCTION(proc_get_status) { RETURN_FALSE; }
+PHP_FUNCTION(proc_terminate)  { RETURN_FALSE; }
+
+PHP_FUNCTION(proc_nice)
+{
+	php_error_docref(NULL, E_WARNING,
+		"proc_nice() is not supported under WASI");
+	RETURN_FALSE;
+}
+
+#else /* !__wasi__ — full implementation follows */
+
 /* {{{ proto resource proc_open(...) */
 PHP_FUNCTION(proc_open)
 {
@@ -312,3 +338,5 @@ PHP_FUNCTION(proc_nice)
 	RETURN_TRUE;
 }
 /* }}} */
+
+#endif /* __wasi__ */
