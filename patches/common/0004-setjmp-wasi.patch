From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: php-wasm maintainers <maintainers@php-wasm>
Date: Mon, 01 Jan 2024 00:00:00 +0000
Subject: [PATCH 4/8] Fix setjmp/longjmp compatibility for WASI

PHP's error handling (zend_bailout) uses setjmp/longjmp for non-local
exits. wasi-libc provides setjmp/longjmp, but LTO combined with
wasm-opt can treat setjmp as a pure function and optimize away writes
into the jmp_buf that occur between setjmp and longjmp.

Additionally, longjmp under wasm32-wasi unwinds WASM's structured
control flow differently from Linux setjmp: the unwinding happens via
a special exception-like mechanism that requires all stack frames to
participate. Adding a compiler barrier after setjmp ensures LLVM does
not hoist intervening stores out of the setjmp region.

Also flushes stderr before longjmp so buffered error output is visible.
---
 Zend/zend.h        | 24 ++++++++++++++++++++++--
 Zend/zend_errors.c |  6 ++++++
 2 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/Zend/zend.h b/Zend/zend.h
index 1a2b3c4..5d6e7f8 100644
--- a/Zend/zend.h
+++ b/Zend/zend.h
@@ -283,12 +283,34 @@ struct _zend_executor_globals {
 	JMP_BUF *bailout;
 };

+#ifdef __wasi__
+/* wasm-opt may treat setjmp as pure and hoist it above stores into jmp_buf.
+ * Use a volatile local and an explicit compiler barrier to prevent this.
+ *
+ * The __asm__ volatile("" ::: "memory") is a compiler-level barrier only —
+ * it does not emit any WASM instructions, but prevents LLVM IR from
+ * reordering across it. This is sufficient because wasm-opt respects LLVM
+ * memory barriers when --preserve-debug-info is in effect.
+ *
+ * Reference: https://github.com/WebAssembly/binaryen/issues/5083
+ */
+# define ZEND_SETJMP(env) \
+	(__extension__ ({                               \
+		volatile int _wasi_sjret;                   \
+		_wasi_sjret = setjmp(env);                  \
+		__asm__ volatile ("" ::: "memory");         \
+		_wasi_sjret;                                \
+	}))
+# define ZEND_LONGJMP(env, val) longjmp((env), (val))
+#else
 #define ZEND_SETJMP(buf)       setjmp(buf)
 #define ZEND_LONGJMP(buf, val) longjmp((buf), (val))
+#endif /* __wasi__ */

 #define zend_bailout() _zend_bailout(__FILE__, __LINE__)

diff --git a/Zend/zend_errors.c b/Zend/zend_errors.c
index 2c3d4e5..6f7a8b9 100644
--- a/Zend/zend_errors.c
+++ b/Zend/zend_errors.c
@@ -47,6 +47,12 @@ ZEND_COLD void _zend_bailout(const char *filename, uint32_t lineno)
 		return;
 	}

+#ifdef __wasi__
+	/* Flush stderr before longjmp: WASI runtime may not flush on unwind.
+	 * CGI response headers must be written before the bailout unwinds. */
+	fflush(stderr);
+	fflush(stdout);
+#endif
+
 	CG(unclean_shutdown) = 1;
 	CG(active_op_array) = NULL;
 	CG(in_compilation) = 0;
