From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: php-wasm maintainers <maintainers@php-wasm>
Date: Mon, 01 Jan 2024 00:00:00 +0000
Subject: [PATCH 7/8] Fix FD_SETSIZE overflow in select() usage

PHP's socket and stream code uses select() with fd_set. On Linux and in
wasi-libc, FD_SETSIZE is 1024. WASI fd numbers are not bounded by
FD_SETSIZE — the host runtime assigns pre-opened directory fds starting
from 3, and may assign numbers above 1023 when many files are open.
Passing such fds to FD_SET writes out-of-bounds into the fd_set bitmask,
corrupting adjacent stack memory.

This patch introduces bounds-checked PHP_FD_SET / PHP_FD_ISSET macros
and replaces direct FD_SET/FD_ISSET calls in the stream liveness check
path. The bounds check is only costly under WASI; on Linux the branch
is a constant-fold to the original FD_SET.
---
 main/streams/plain_wrapper.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/main/streams/plain_wrapper.c b/main/streams/plain_wrapper.c
index f1e2d3a..b4c5d6e 100644
--- a/main/streams/plain_wrapper.c
+++ b/main/streams/plain_wrapper.c
@@ -38,6 +38,28 @@
 #include <sys/select.h>
 #endif

+#ifdef __wasi__
+/* WASI fd numbers are not bounded by FD_SETSIZE. Guard all FD_SET/FD_ISSET
+ * calls to prevent out-of-bounds writes into the fd_set bitmask. */
+static inline void php_wasi_fd_set_safe(int fd, fd_set *set)
+{
+	if (UNEXPECTED(fd < 0 || fd >= FD_SETSIZE)) {
+		/* fd too large for select(); caller must handle this case */
+		return;
+	}
+	FD_SET(fd, set);
+}
+static inline int php_wasi_fd_isset_safe(int fd, const fd_set *set)
+{
+	if (UNEXPECTED(fd < 0 || fd >= FD_SETSIZE)) {
+		return 0;
+	}
+	return FD_ISSET(fd, set);
+}
+# define PHP_FD_SET(fd, set)   php_wasi_fd_set_safe((fd), (set))
+# define PHP_FD_ISSET(fd, set) php_wasi_fd_isset_safe((fd), (set))
+#else
+# define PHP_FD_SET(fd, set)   FD_SET((fd), (set))
+# define PHP_FD_ISSET(fd, set) FD_ISSET((fd), (set))
+#endif /* __wasi__ */
+
 static php_stream_ops php_plain_files_ops;

@@ -201,13 +223,21 @@ static int php_stdiop_set_option(
 	switch (option) {
 		case PHP_STREAM_OPTION_CHECK_LIVENESS: {
 			struct timeval tv;
-			fd_set fds;
-			int this_fd;
-			tv.tv_sec = 0;
-			tv.tv_usec = 0;
-			this_fd = fileno((FILE *)stream->abstract);
+			fd_set  fds;
+			int     this_fd = fileno((FILE *)stream->abstract);
+			if (this_fd < 0) {
+				return PHP_STREAM_OPTION_RETURN_ERR;
+			}
+#ifdef __wasi__
+			if (this_fd >= FD_SETSIZE) {
+				/* fd too large for select; assume stream is live */
+				return PHP_STREAM_OPTION_RETURN_OK;
+			}
+#endif
+			tv.tv_sec  = 0;
+			tv.tv_usec = 0;
 			FD_ZERO(&fds);
-			FD_SET(this_fd, &fds);
-			if (select(this_fd + 1, &fds, NULL, NULL, &tv) > 0
-				&& FD_ISSET(this_fd, &fds)) {
+			PHP_FD_SET(this_fd, &fds);
+			if (select(this_fd + 1, &fds, NULL, NULL, &tv) > 0
+				&& PHP_FD_ISSET(this_fd, &fds)) {
 				return PHP_STREAM_OPTION_RETURN_OK;
 			}
