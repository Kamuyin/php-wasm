From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: php-wasm maintainers <maintainers@php-wasm>
Date: Mon, 01 Jan 2024 00:00:00 +0000
Subject: [PATCH 2/8] Disable fiber assembly for WASI target

PHP Fibers use platform-specific assembly stubs in Zend/asm/ for context
switching. The wasm32-wasi target has no native stack switching and
wasi-libc does not provide ucontext. Since PHP's --disable-fiber-asm
configure flag only disables the asm path (falling back to ucontext),
we must also stub out the ucontext API for WASI.

This patch replaces the fiber context-switch implementation with a stub
that throws E_ERROR on first switch, since WASM coroutine-style switching
is not available in wasm32-wasi Preview1. Code that merely creates but
never resumes a Fiber will load successfully.
---
 Zend/zend_fibers.c | 42 ++++++++++++++++++++++++++++++++++++++++++
 configure.ac       |  8 ++++++++
 2 files changed, 50 insertions(+)

diff --git a/Zend/zend_fibers.c b/Zend/zend_fibers.c
index b1c2d3e..f4e5d6a 100644
--- a/Zend/zend_fibers.c
+++ b/Zend/zend_fibers.c
@@ -52,6 +52,46 @@
 # include <ucontext.h>
 #endif

+#ifdef __wasi__
+/* WASI does not support ucontext-based stack switching.
+ * Fiber creation is permitted but suspension/resumption throws E_ERROR.
+ * This allows code that conditionally creates fibers to load, while
+ * preventing silent state corruption from an unsupported context switch. */
+
+typedef struct {
+	void  *stack;
+	size_t stack_size;
+	int    started;
+} zend_wasi_fiber_handle;
+
+static zend_result zend_fiber_init_context(
+	zend_fiber_context *context,
+	zend_fiber_coroutine coroutine,
+	size_t stack_size)
+{
+	zend_wasi_fiber_handle *h = emalloc(sizeof(zend_wasi_fiber_handle));
+	h->stack      = emalloc(stack_size);
+	h->stack_size = stack_size;
+	h->started    = 0;
+	context->handle = h;
+	(void)coroutine;
+	return SUCCESS;
+}
+
+static void zend_fiber_switch_context(
+	zend_fiber_context *from,
+	zend_fiber_context *to)
+{
+	(void)from; (void)to;
+	zend_error_noreturn(E_ERROR,
+		"Fiber context switching is not supported under WASI (wasm32-wasi Preview1). "
+		"Refactor to use iterators or generator-style coroutines instead.");
+}
+
+static void zend_fiber_destroy_context(zend_fiber_context *context)
+{
+	if (context->handle) {
+		zend_wasi_fiber_handle *h = context->handle;
+		efree(h->stack);
+		efree(h);
+		context->handle = NULL;
+	}
+}
+
+#else /* !__wasi__ — normal ucontext/asm implementation follows */
+
 #if defined(ZEND_FIBER_UCONTEXT)
 typedef ucontext_t zend_fiber_ucontext;
diff --git a/configure.ac b/configure.ac
index c3d4e5f..a6b7c8d 100644
--- a/configure.ac
+++ b/configure.ac
@@ -311,6 +311,14 @@ PHP_ARG_ENABLE([fiber-asm],
   [whether to use boost fiber assembly],
   [AS_HELP_STRING([--disable-fiber-asm],
     [Disable fiber assembly (required for WASI/WebAssembly targets)])],
   [yes])

+dnl Force-disable fiber asm for WASI target (no ucontext, no setcontext)
+case "$host" in
+  wasm32-wasi*|wasm32-unknown-wasi*)
+    PHP_FIBER_ASM="no"
+    AC_DEFINE([ZEND_FIBER_UCONTEXT], [0],
+      [Set to 0 to use WASI fiber stubs instead of ucontext])
+    AC_MSG_NOTICE([fibers: using WASI stub implementation (no ucontext)])
+    ;;
+esac
